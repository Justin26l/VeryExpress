{
    "jsonSchemaDir": "./output/jsonSchema",
    "rootDir": "./output",
    "srcDir": "./output/src",
    "openapiDir": "./output/src/openapi",
    "sysDir": "output/src/system",
    "app": {
        "enableSwagger": true,
        "useUserSchema": true,
        "useObjectID": true,
        "allowApiCreateUpdate_id": false,
        "useStatefulRedisAuth": false,
        "showSoftDeleted": false
    },
    "auth": {
        "localAuth": true,
        "useHttpOnlyCookieToken": true,
        "deleteAccount": true,
        "oauthProviders": {
            "google": false,
            "github": false
        },
        "externalIdentity": {
            "enabled": true,
            "preset": "firebase",
            "projectId": "renomaster-c36d6",
            "signInMethod": "redirect"
        }
    },
    "useRBAC": {
        "roles": [
            "visitor",
            "member",
            "admin"
        ],
        "default": "admin"
    },
    "generator": {
        "commitBeforeGenerate": false,
        "disableVersionLabel": false
    },
    "dbType": "sql"
}