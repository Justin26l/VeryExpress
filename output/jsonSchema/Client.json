        },
        "createdBy": {
            "type": "string",
            "x-format": "UUID",
            "default": "onCreateUserId"
        },
        "updatedAt": {
            "type": "string",
            "x-format": "Timestamp",
            "default": "onUpdateTimestamp"
        },
        "updatedBy": {
            "type": "string",
            "x-format": "UUID",
