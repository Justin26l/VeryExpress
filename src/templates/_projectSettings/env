APP_HOST=http://localhost
APP_PORT=3000
MONGODB_URI=mongodb://localhost:27017/veryExpressDB
SQL_URI=postgresql://username:password@localhost:5432/mydatabase
SQL_CA=""
SQL_INSECURE_TLS=true
SQL_SYNCHRONIZE=true

LOGIN_SUCCESS_REDIRECT_PATH=/logincallback
LOGIN_FAILED_REDIRECT_PATH=/logincallback

# OAUTH
OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_CLIENTSECRET=
OAUTH_GITHUB_CLIENTID=
OAUTH_GITHUB_CLIENTSECRET=
# OAUTH_MICROSOFT_CLIENTID=
# OAUTH_MICROSOFT_CLIENTSECRET=
# OAUTH_APPLE_CLIENTID=
# OAUTH_APPLE_CLIENTSECRET=

# EXTERNAL IDENTITY (broker SSO) — see auth.externalIdentity in vex.config.json
# These are the broker's *public* browser config values: they are served to the login page by design,
# and are not secrets. There is no client secret here — the ID token is verified against the issuer's
# published JWKS, so the backend holds no broker credential at all.
# NOTE: .env is read once at process start; the dev watcher reloads on changes to this file. But
# dotenv never overrides a variable that is ALREADY set in the environment — if a name here is also
# exported by your shell, IDE launch config or container, that value wins and this file is ignored for
# it. The server logs which values it could not resolve, and says when one is being shadowed.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# JWT token
ACCESS_TOKEN_EXPIRE_TIME='1h'
REFRESH_TOKEN_EXPIRE_TIME='24h'
SESSION_COOKIE_SECRET='my-session-cookie-secret'
JWT_ALGORITHM='HS256'
JWT_SECRET0='my-secret-key0'