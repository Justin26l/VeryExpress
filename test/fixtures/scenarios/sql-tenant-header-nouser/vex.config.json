{
    "jsonSchemaDir": "./schemas",
    "rootDir": "./out",
    "dbType": "sql",
    "app": {
        "enableSwagger": true,
        "useUserSchema": false,
        "useObjectID": true,
        "allowApiCreateUpdate_id": false
    },
    "auth": {
        "localAuth": false,
        "useHttpOnlyCookieToken": false,
        "deleteAccount": false,
        "oauthProviders": {
            "google": false,
            "github": false
        }
    },
    "tenant": {
        "enable": true,
        "IsolationMode": "preSelect",
        "scope": [
            "/api"
        ]
    },
    "generator": {
        "commitBeforeGenerate": false
    }
}
