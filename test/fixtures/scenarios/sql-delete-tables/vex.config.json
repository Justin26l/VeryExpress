{
    "jsonSchemaDir": "./schemas",
    "rootDir": "./out",
    "dbType": "sql",
    "app": {
        "enableSwagger": true,
        "useUserSchema": true,
        "useObjectID": true,
        "allowApiCreateUpdate_id": false
    },
    "auth": {
        "localAuth": true,
        "useHttpOnlyCookieToken": true,
        "deleteAccount": {
            "enabled": true,
            "deleteTables": ["UserContact", "UserNote"]
        },
        "oauthProviders": {
            "google": false,
            "github": false
        }
    },
    "generator": {
        "commitBeforeGenerate": false
    }
}
